# Copy to .env and fill in. Never commit .env.
# Have I Been Pwned API key (optional; enables the hibp source). https://haveibeenpwned.com/API/Key
DARKWATCH_HIBP_KEY=
# Optional alerting. Discord/Slack-style incoming webhook.
DARKWATCH_WEBHOOK_URL=
# Optional email alerts.
DARKWATCH_SMTP_HOST=
DARKWATCH_SMTP_PORT=587
DARKWATCH_SMTP_USER=
DARKWATCH_SMTP_PASSWORD=
DARKWATCH_SMTP_FROM=
DARKWATCH_SMTP_TO=
